rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // The same approved inspection team may access photo evidence.
    function isInspector() {
      return request.auth != null && request.auth.token.assetInspector == true;
    }
    match /inspections/{inspectionId}/{allPaths=**} {
      allow read, write: if isInspector();
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
