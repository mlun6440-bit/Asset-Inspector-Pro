rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // The same approved inspection team may access photo evidence.
    function isInspector() {
      return request.auth != null && request.auth.token.assetInspector == true;
    }

    // Inspection photos, asset crops and site documents: images or PDFs, max 15 MB.
    match /inspections/{inspectionId}/{allPaths=**} {
      allow read, delete: if isInspector();
      allow write: if isInspector()
        && request.resource.size < 15 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
    }

    // Default-deny catch-all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
