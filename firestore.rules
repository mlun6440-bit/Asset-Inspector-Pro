rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Every request must come from a signed-in Firebase user. The app signs in
    // anonymously on load; for production, replace anonymous sign-in with a real
    // provider (e.g. Microsoft/Google restricted to your company domain) and
    // tighten isSignedIn() to check request.auth.token.email.
    function isSignedIn() {
      return request.auth != null;
    }

    match /inspections/{inspectionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasAll(['siteInfo', 'rooms', 'lastUpdated']);
      allow delete: if isSignedIn();

      match /assets/{assetId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn()
          && request.resource.data.keys().hasAll(['id', 'category', 'condition']);
        allow delete: if isSignedIn();
      }

      // Presence documents for live collaboration
      match /presence/{userId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn()
          && request.resource.data.keys().hasAll(['userId', 'email', 'lastActive']);
        allow delete: if isSignedIn();
      }
    }
  }
}
