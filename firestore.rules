rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Inspections collection rules
    match /inspections/{inspectionId} {
      // Allows anyone to read or write to inspections.
      // For higher security, change this to: if request.auth != null;
      allow read, write: if true;

      // Assets subcollection matching
      match /assets/{assetId} {
        allow read, write: if true;
      }

      // Presence subcollection matching
      match /presence/{userId} {
        allow read, write: if true;
      }
    }
  }
}
