rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Assigned only through the trusted Firebase Admin SDK. Anonymous sign-in
    // and client-supplied inspection/profile fields never grant team access.
    function isInspector() {
      return request.auth != null && request.auth.token.assetInspector == true;
    }
    match /inspections/{inspectionId} {
      allow read, write: if isInspector();
      match /assets/{assetId} {
        allow read, write: if isInspector();
      }
      match /presence/{userId} {
        allow read, write: if isInspector();
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
