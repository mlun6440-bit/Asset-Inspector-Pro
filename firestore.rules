rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Assigned only through the trusted Firebase Admin SDK. Anonymous sign-in
    // and client-supplied inspection/profile fields never grant team access.
    function isInspector() {
      return request.auth != null && request.auth.token.assetInspector == true;
    }

    match /inspections/{inspectionId} {
      allow read, delete: if isInspector();
      allow create, update: if isInspector()
        && request.resource.data.keys().hasAll(['siteInfo', 'rooms', 'lastUpdated']);

      match /assets/{assetId} {
        allow read, delete: if isInspector();
        allow create, update: if isInspector()
          && request.resource.data.keys().hasAll(['id', 'category', 'condition']);
      }

      // Presence documents for live collaboration
      match /presence/{userId} {
        allow read, delete: if isInspector();
        allow create, update: if isInspector()
          && request.resource.data.keys().hasAll(['userId', 'email', 'lastActive']);
      }
    }

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
