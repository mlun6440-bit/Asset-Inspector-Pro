# Gemini API Key — SERVER-SIDE ONLY.
# Read by the Vite dev proxy (npm run dev) and by server.mjs (npm start).
# It is never bundled into browser code. Do not prefix it with VITE_.
GEMINI_API_KEY=

# Optional: lock the production proxy to your app's origin
# ALLOWED_ORIGIN=https://inspector.example.com

# AI endpoints (/api/gemini, /api/live-token) require a signed-in Firebase user with the
# assetInspector claim. server.mjs enforces this by default; the Vite dev server doesn't.
#   GEMINI_PROXY_AUTH=on   enforce in `npm run dev`
#   GEMINI_PROXY_AUTH=off  disable in `npm start` (local testing only — never in production)
# GEMINI_PROXY_AUTH=
# Optional override; defaults to apiKey in firebase-applet-config.json
# FIREBASE_WEB_API_KEY=

# Google Maps Platform API Key (client-side by design).
# Restrict it to your domain (HTTP referrer restriction) in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=
