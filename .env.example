# Gemini API Key — SERVER-SIDE ONLY.
# Read by the Vite dev proxy (npm run dev) and by server.mjs (npm start).
# It is never bundled into browser code. Do not prefix it with VITE_.
GEMINI_API_KEY=

# Optional: lock the production proxy to your app's origin
# ALLOWED_ORIGIN=https://inspector.example.com

# AI endpoints (/api/gemini, /api/live-token) require a signed-in Firebase user with the
# assetInspector claim. server.mjs enforces this by default; the Vite dev server doesn't.
#   GEMINI_PROXY_AUTH=on   enforce in `npm run dev`
#   GEMINI_PROXY_AUTH=off  disable in `npm start` (local testing only — never in production)
# GEMINI_PROXY_AUTH=
# Optional override; defaults to apiKey in firebase-applet-config.json
# FIREBASE_WEB_API_KEY=

# Google Maps Platform API Key (client-side by design).
# Restrict it to your domain (HTTP referrer restriction) in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=

# Firebase App Check (recommended before real users). Create a reCAPTCHA Enterprise key for your
# domain, register it under App Check in the Firebase console, then enforce App Check for
# Firestore, Storage and Authentication there. Leave blank to run without App Check.
VITE_FIREBASE_APPCHECK_SITE_KEY=
# Local development only: true prints a debug token in the browser console to register
# VITE_FIREBASE_APPCHECK_DEBUG=

# AI usage limits per inspector (server.mjs and dev server). Defaults shown.
# AI_RATE_PER_MINUTE=30
# AI_RATE_PER_DAY=1000
# LIVE_TOKENS_PER_HOUR=12
# Models the Gemini proxy will forward (comma-separated)
# GEMINI_ALLOWED_MODELS=gemini-3.7-flash

# Dev server listens on localhost only; set to 0.0.0.0 to test from a phone on a trusted network
# DEV_HOST=
